# Copie este arquivo para .env e substitua apenas os placeholders.
# Nunca versione o .env real nem credenciais de qualquer ambiente.

# PostgreSQL/Supabase (consumido pelo backend e pelos loaders Python)
SUPABASE_DB_URL=jdbc:postgresql://<host>:5432/postgres
SUPABASE_DB_USER=replace_me
SUPABASE_DB_PASSWORD=replace_me

# Gemini (consumido pelo backend)
GEMINI_API_KEY=replace_me

# Backend Spring local.
PORT=8080
# CORS existe somente para desenvolvimento local.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend publico, opcional e somente para desenvolvimento/teste local.
# Nao cadastre em Preview/Production: builds de producao sempre usam snapshots /data.
# Toda variavel VITE_* e incorporada ao bundle e visivel no browser: nunca use secrets.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# S3 opcional/legado (consumido somente com run_local.py --upload-s3)
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
AWS_REGION=replace_me
