# Opcional somente para desenvolvimento/teste local. Nao cadastrar em Preview/Production:
# builds de producao sempre usam /api/v1 same-origin. Toda VITE_* e publica.
# O default local ja e http://localhost:8080/api/v1.
# Toda variavel VITE_* e publica e visivel no bundle do browser. Nunca coloque secrets aqui.
VITE_API_BASE_URL=http://localhost:8080/api/v1
